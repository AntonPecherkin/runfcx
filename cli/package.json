{
  "name": "runfcx",
  "version": "0.1.2",
  "description": "runfcx: run a Farcaster node and client with your agent. Half the disk, no API keys.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "runfcx": "dist/cli.js"
  },
  "files": [
    "dist",
    "remote"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:remote": "bats test/remote",
    "lint:remote": "shellcheck remote/*.sh",
    "site:check": "node --test ../site/tools/test/*.test.mjs && node ../site/tools/check.mjs"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "dependencies": {
    "@farcaster/core": "0.20.0",
    "viem": "2.37.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntonPecherkin/fcx-cli.git",
    "directory": "cli"
  },
  "homepage": "https://antonpecherkin.github.io/fcx-cli/"
}
